{
  "name": "teddy-fyi-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "echo 'Pick an app: pnpm dev:personal (5173) or pnpm dev:grocery (5174)' && exit 1",
    "dev:personal": "pnpm --filter personal dev",
    "dev:grocery": "pnpm --filter grocery dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
